         config = VLAConfig(**config_dict)
         print("loading model")
         print("config.action_head_cfg", config.action_head_cfg)
+        # The released DreamZero checkpoint is a full VLA checkpoint: it already
+        # contains the text/image/VAE/DiT weights.  Avoid downloading the original
+        # Wan base components again while constructing the model; the full state
+        # dict is loaded immediately below.
+        if isinstance(config.action_head_cfg, dict):
